# Copie para .env.test (testes de integração) ou .env (aplicação) e preencha.
# Nunca faça commit dos arquivos preenchidos.

# Credenciais de TESTE (Suas integrações > Credenciais de teste)
PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Assinatura secreta dos webhooks (Suas integrações > Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=

# Opcional: e-mail do pagador nos testes de integração
# MP_PAYER_EMAIL=comprador.teste@gmail.com
